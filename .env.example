# 実際の値はコミットしない。EAS Secrets(eas secret:create)または
# ローカル開発時は .env(gitignore対象)にコピーして設定する。
# spec.md 6章: APIキーはクライアントに一切埋め込まない方針のため、
# vision LLM APIキー自体はここには含まれない(プロキシ側のみが保持)。

# 写真判定・返信支援のプロキシ(nobishiro-proxy、別リポジトリ)のベースURL
EXPO_PUBLIC_PROXY_BASE_URL=https://example-proxy.workers.dev

# RevenueCat 公開APIキー(iOS)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# PostHog プロジェクトAPIキー・ホスト
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN(AC-017: 未設定時はSentry初期化をスキップする)
EXPO_PUBLIC_SENTRY_DSN=

# 設定画面(S-11)からリンクするストア掲載用ドキュメント。
# release-checklist.md 6-1「プライバシーポリシーの作成・掲載先URL確定」が未完了のため、
# STEP4実装時点(T14)では未設定。未設定時はアプリ内で「準備中」表示にしてリンクを無効化する
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
